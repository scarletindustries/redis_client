// Pub/Sub.
//
// Publishing is an ordinary command and works on an ordinary `Conn`.
// Subscribing is not: SUBSCRIBE puts the connection into a mode where the
// server sends messages nobody asked for, whenever they happen. That breaks
// the one assumption `Conn` is built on — that a reply arrives only in answer
// to a command — so a subscriber gets its own type.
//
// `Subscription` is threaded through each call, returning a new one alongside
// each message, because here the leftover read buffer is real state: several
// messages can arrive in a single TCP segment, and a subscriber that dropped
// the tail of a read would lose every message that shared a packet with
// another. This is exactly the buffer `Conn` was able to prove empty and
// therefore does not carry.
//
// A `Subscription` takes over the transport of the `Conn` it was made from.
// That connection must not be used for commands again, and closing either
// closes the same socket. The transport is the same sum a `Conn` holds, so
// a subscriber works in the clear or under TLS.

import scarlet/array
import scarlet/result
import scarlet/binary
import scarlet/net/error.{TimedOut, UnexpectedEof}
import scarlet/net/socket.{Closed, Data}
import ./redis.{Conn, Net, RedisError, Transport}
import ./resp.{Bad, Done, List, NeedMore, Push}

const READ_SIZE = 65536

pub opaque type Subscription {
	sock Transport
	// Bytes received but not yet consumed by a message.
	buf Binary
}

// What the server can send to a subscriber.
pub type Event {
	// A message on a channel subscribed to by name.
	Message(channel String, payload String)
	// A message on a channel that matched a pattern subscription. Both the
	// pattern and the actual channel are reported, since one pattern can match
	// many channels.
	PatternMessage(pattern String, channel String, payload String)
	// A message on a shard channel (SSUBSCRIBE).
	ShardMessage(channel String, payload String)
	// Confirmation of a subscription change, with the number of subscriptions
	// this connection now holds. When that count reaches zero the connection
	// leaves subscriber mode and can be used for commands again.
	Subscribed(channel String, count Int)
	Unsubscribed(channel String, count Int)
}

// ---------------------------------------------------------------------------
// Publishing — ordinary commands on an ordinary connection.
// ---------------------------------------------------------------------------

// Post a message, returning how many subscribers received it. That count does
// not include subscribers on other shards of a cluster.
pub fn publish(c Conn, channel String, payload String) Result(Int, RedisError) {
	redis.expect_int(redis.command(c, ['PUBLISH', channel, payload]))
}

pub fn spublish(c Conn, channel String, payload String) Result(Int, RedisError) {
	redis.expect_int(redis.command(c, ['SPUBLISH', channel, payload]))
}

// Channels with at least one subscriber, optionally filtered by a glob
// pattern. Pattern subscriptions are not counted here — `numpat` reports those.
pub fn channels(c Conn, pattern Option(String)) Result(Array(String), RedisError) {
	redis.expect_strings(
		redis.command(c, redis.parts([['PUBSUB', 'CHANNELS'], redis.when_some(pattern, fn(p) [p])])),
	)
}

pub fn numsub(c Conn, of_channels Array(String)) Result(Array((String, Int)), RedisError) {
	counts(redis.command(c, redis.parts([['PUBSUB', 'NUMSUB'], of_channels])))
}

// How many pattern subscriptions exist across the server.
pub fn numpat(c Conn) Result(Int, RedisError) {
	redis.expect_int(redis.command(c, ['PUBSUB', 'NUMPAT']))
}

pub fn shard_channels(c Conn, pattern Option(String)) Result(Array(String), RedisError) {
	redis.expect_strings(
		redis.command(
			c,
			redis.parts([['PUBSUB', 'SHARDCHANNELS'], redis.when_some(pattern, fn(p) [p])]),
		),
	)
}

pub fn shard_numsub(c Conn, of_channels Array(String)) Result(Array((String, Int)), RedisError) {
	counts(redis.command(c, redis.parts([['PUBSUB', 'SHARDNUMSUB'], of_channels])))
}

// NUMSUB answers with a flat channel/count array.
fn counts(reply Result(resp.Value, RedisError)) Result(Array((String, Int)), RedisError) {
	values <- result.then(redis.expect_values(reply))
	pair_counts(values)
}

fn pair_counts(values Array(resp.Value)) Result(Array((String, Int)), RedisError) {
	match values {
		[] -> Ok([])
		[name, count, ..rest] -> {
			n <- result.then(redis.value_text(name))
			k <- result.then(redis.value_int(count))
			more <- result.then(pair_counts(rest))
			Ok(array.concat([(n, k)], more))
		}
		_ -> Err(redis.Protocol('expected channel/count pairs'))
	}
}

// ---------------------------------------------------------------------------
// Subscribing.
// ---------------------------------------------------------------------------

// Take a connection into subscriber mode. The confirmations the server sends —
// one per channel — are consumed here, so the first message from
// `next_message` is real traffic rather than bookkeeping.
pub fn subscribe(c Conn, to_channels Array(String)) Result(Subscription, RedisError) {
	start(c, 'SUBSCRIBE', to_channels)
}

// Subscribe by glob pattern. `news.*` catches every channel under `news.`.
pub fn psubscribe(c Conn, patterns Array(String)) Result(Subscription, RedisError) {
	start(c, 'PSUBSCRIBE', patterns)
}

// Subscribe to shard channels, which in a cluster stay on one shard rather
// than being broadcast to every node.
pub fn ssubscribe(c Conn, to_channels Array(String)) Result(Subscription, RedisError) {
	start(c, 'SSUBSCRIBE', to_channels)
}

fn start(c Conn, verb String, names Array(String)) Result(Subscription, RedisError) {
	// A `Subscription` owns its transport for as long as it lives, so a pooled
	// connection is refused here rather than leased and never given back.
	sock <- result.then(redis.transport_of(c))
	match redis.transport_write(
		sock,
		resp.encode_command(array.map(array.concat([verb], names), binary.from_string)),
	) {
		Err(e) -> Err(e)
		Ok(Nil) -> drain(Subscription(sock: sock, buf: <<>>), array.length(names))
	}
}

// Consume exactly one confirmation per name asked for, so the subscription is
// fully established before it is handed back.
fn drain(s Subscription, remaining Int) Result(Subscription, RedisError) {
	if remaining <= 0 {
		Ok(s)
	} else {
		match next_message(s) {
			(next, Ok(Subscribed(_, _))) -> drain(next, remaining - 1)
			(next, Ok(Unsubscribed(_, _))) -> drain(next, remaining - 1)
			(_, Ok(_)) -> Err(redis.Protocol('expected a subscription confirmation'))
			(_, Err(e)) -> Err(e)
		}
	}
}

// Add channels to an existing subscription.
pub fn subscribe_more(
	s Subscription,
	to_channels Array(String),
) (Subscription, Result(Nil, RedisError)) {
	send(s, 'SUBSCRIBE', to_channels)
}

// Stop listening. With an empty list, every channel is dropped. The
// confirmations arrive as ordinary `Unsubscribed` pushes from `next_message`,
// and once their count reaches 0 the connection is out of subscriber mode.
pub fn unsubscribe(
	s Subscription,
	from_channels Array(String),
) (Subscription, Result(Nil, RedisError)) {
	send(s, 'UNSUBSCRIBE', from_channels)
}

pub fn punsubscribe(
	s Subscription,
	patterns Array(String),
) (Subscription, Result(Nil, RedisError)) {
	send(s, 'PUNSUBSCRIBE', patterns)
}

pub fn sunsubscribe(
	s Subscription,
	from_channels Array(String),
) (Subscription, Result(Nil, RedisError)) {
	send(s, 'SUNSUBSCRIBE', from_channels)
}

fn send(s Subscription, verb String, names Array(String)) (Subscription, Result(Nil, RedisError)) {
	request = resp.encode_command(array.map(array.concat([verb], names), binary.from_string))
	match redis.transport_write(s.sock, request) {
		Ok(Nil) -> (s, Ok(Nil))
		Err(e) -> (s, Err(e))
	}
}

pub fn close(s Subscription) Nil {
	redis.transport_close(s.sock)
}

// ---------------------------------------------------------------------------
// Receiving.
// ---------------------------------------------------------------------------

// Wait for the next message, parking this process until one arrives. Other
// processes keep running; this one is idle, not spinning.
pub fn next_message(s Subscription) (Subscription, Result(Event, RedisError)) {
	match take(s) {
		(next, Ok(value)) -> (next, decode(value))
		(next, Err(e)) -> (next, Err(e))
	}
}

// The same, but giving up after `timeout_ms` with `Ok(None)`. For a loop that
// has to do something else periodically — check a shutdown flag, emit a
// heartbeat — rather than block for ever.
//
// Over TLS this is not yet wired to `scarlet/net/tls`'s `read_within`
// (T-529). The call returns `Err(Misuse(..))` rather than parking in an
// unbounded `tls.read`. A timeout that was ignored would hang, not fail.
pub fn next_message_within(
	s Subscription,
	timeout_ms Int,
) (Subscription, Result(Option(Event), RedisError)) {
	match take_within(s, timeout_ms) {
		(next, Ok(None)) -> (next, Ok(None))
		(next, Ok(Some(value))) -> match decode(value) {
			Ok(push) -> (next, Ok(Some(push)))
			Err(e) -> (next, Err(e))
		}
		(next, Err(e)) -> (next, Err(e))
	}
}

// Parse one message out of the buffer, reading more only when what is there is
// not yet a whole one. The leftover is kept: it may already hold the next
// message in full.
fn take(s Subscription) (Subscription, Result(resp.Value, RedisError)) {
	match resp.parse(s.buf, 0) {
		Done(value, next) -> (Subscription(..s, buf: binary.drop_bytes(s.buf, next)), Ok(value))
		Bad(why) -> (s, Err(redis.Protocol(why)))
		NeedMore -> match redis.transport_read(s.sock, READ_SIZE) {
			Ok(Data(chunk)) -> take(Subscription(..s, buf: binary.append(s.buf, chunk)))
			Ok(Closed) -> (s, Err(Net(UnexpectedEof)))
			Err(e) -> (s, Err(e))
		}
	}
}

fn take_within(
	s Subscription,
	timeout_ms Int,
) (Subscription, Result(Option(resp.Value), RedisError)) {
	match resp.parse(s.buf, 0) {
		Done(value, next) ->
			(Subscription(..s, buf: binary.drop_bytes(s.buf, next)), Ok(Some(value)))
		Bad(why) -> (s, Err(redis.Protocol(why)))
		NeedMore -> match redis.transport_read_within(s.sock, READ_SIZE, timeout_ms) {
			Ok(Data(chunk)) ->
				take_within(Subscription(..s, buf: binary.append(s.buf, chunk)), timeout_ms)
			Ok(Closed) -> (s, Err(Net(UnexpectedEof)))
			// Not a failure: the deadline passed with nothing to report. Any
			// partial message already read stays in the buffer for next time.
			Err(Net(TimedOut)) -> (s, Ok(None))
			Err(e) -> (s, Err(e))
		}
	}
}

// Every push is an array whose first element names the kind.
fn decode(value resp.Value) Result(Event, RedisError) {
	parts <- result.then(frame_items(value))
	match parts {
		[kind, a, b] -> {
			name <- result.then(redis.value_text(kind))
			two(name, a, b)
		}
		[kind, a, b, c] -> {
			name <- result.then(redis.value_text(kind))
			three(name, a, b, c)
		}
		_ -> Err(redis.Protocol('unexpected pub/sub push shape'))
	}
}

// RESP3 delivers pub/sub out of band as a `>` push frame. RESP2 sent the same
// three elements as an ordinary array, and the contents are identical, so only
// the wrapper differs.
fn frame_items(v resp.Value) Result(Array(resp.Value), RedisError) {
	match v {
		Push(items) -> Ok(items)
		List(items) -> Ok(items)
		other -> redis.expect_values(Ok(other))
	}
}

fn two(name String, a resp.Value, b resp.Value) Result(Event, RedisError) {
	match name {
		'message' -> {
			channel <- result.then(redis.value_text(a))
			payload <- result.then(redis.value_text(b))
			Ok(Message(channel, payload))
		}
		'smessage' -> {
			channel <- result.then(redis.value_text(a))
			payload <- result.then(redis.value_text(b))
			Ok(ShardMessage(channel, payload))
		}
		'subscribe' -> confirmation(a, b, True)
		'psubscribe' -> confirmation(a, b, True)
		'ssubscribe' -> confirmation(a, b, True)
		'unsubscribe' -> confirmation(a, b, False)
		'punsubscribe' -> confirmation(a, b, False)
		'sunsubscribe' -> confirmation(a, b, False)
		other -> Err(redis.Protocol('unknown pub/sub push: ${other}'))
	}
}

fn three(name String, a resp.Value, b resp.Value, c resp.Value) Result(Event, RedisError) {
	match name {
		'pmessage' -> {
			pattern <- result.then(redis.value_text(a))
			channel <- result.then(redis.value_text(b))
			payload <- result.then(redis.value_text(c))
			Ok(PatternMessage(pattern, channel, payload))
		}
		other -> Err(redis.Protocol('unknown three-part pub/sub push: ${other}'))
	}
}

// An unsubscribe-all reports a null channel, since it names no one channel.
fn confirmation(a resp.Value, b resp.Value, subscribed Bool) Result(Event, RedisError) {
	channel = match redis.value_text(a) {
		Ok(name) -> name
		Err(_) -> ''
	}
	count <- result.then(redis.value_int(b))
	if subscribed {
		Ok(Subscribed(channel, count))
	} else {
		Ok(Unsubscribed(channel, count))
	}
}

// A Redis client over a TCP socket, in the clear or under TLS.
//
// This module is the connection and the reply-decoding vocabulary. The
// commands themselves live in `./redis/<group>.scrl`, one module per Redis
// command group, and every one of them is built from `command` plus the
// `expect_*` decoders below.
//
// A `Conn` is a transport — no read buffer threaded through the caller's
// code, because under strict request/response there is nothing to thread. We
// write one command and read until exactly one reply is complete; Redis sends
// exactly one reply per command and never speaks unbidden, so bytes arriving
// past the end of that reply cannot belong to anything we asked for. Rather
// than carry a buffer that is provably always empty at a command boundary,
// `read_reply` checks for those bytes and reports the desync as an error. A
// silent corruption becomes a loud, typed one.
//
// Two things that invariant does not cover. Pub/Sub, where the server pushes
// messages nobody asked for, is why `./redis/pubsub.scrl` has its own
// buffer-owning `Subscription` type rather than reusing `Conn`. Pipelining —
// more than one command in flight — would need the same, and is not offered.
//
// A `Conn` is a transport, or else it is a pool of them. The second kind holds
// no socket at all: it forwards each command to `./redis/pool.scrl`, which runs it
// on whichever of its connections is free and sends the reply back. The two are
// one type because every command in this library is a function of a `Conn`, and
// making a pool a second type would mean either writing all of them twice or
// wrapping every call in a block to bridge the gap. They are the same type
// instead, so `strings.get(c, k)` is the same line of code whether `c` is one
// connection or eight, and a function written against one works against the
// other unchanged.
//
// What differs is what the two promise. A socket-backed `Conn` must not be
// shared between processes: two of them writing down one socket would
// interleave requests and read each other's replies. A pool-backed one is built
// to be shared — it is a mailbox address, and the socket never leaves the
// process that dialled it. What a pool cannot promise is that two consecutive
// commands land on the same connection, which WATCH/MULTI needs and
// `pool.with_conn` is for.

import scarlet/array
import scarlet/binary
import scarlet/int
import scarlet/net
import scarlet/result
import scarlet/net/error.{NetError, UnexpectedEof}
import scarlet/net/socket.{Closed, Data, Read, Socket}
import scarlet/net/tls
import scarlet/process
import scarlet/process.{Crash, Down, Pid, Subject}
import scarlet/resource
import scarlet/string
import ./number.{Score}
import ./resp.{
	Bad,
	BigNum,
	BlobErr,
	Boolean,
	Bulk,
	Dbl,
	Done,
	List,
	Map,
	NeedMore,
	Null,
	Num,
	Push,
	RedisErr,
	Set,
	SimpleStr,
	Value,
	Verbatim,
}

// How much to ask the kernel for per read. Replies smaller than this arrive in
// one call; larger ones simply loop.
const READ_SIZE = 65536

// Opaque: the only way to get one is `connect`, `with_conn` or `pool.start`, so
// a `Conn` in hand is always a socket that was actually dialled, or a pool
// whose connections were.
pub opaque type Conn {
	Direct(transport Transport)
	// A pool, reached through the closure the pool handed us. It is a closure
	// rather than the pool's own mailbox because the two modules would
	// otherwise have to import each other: this way `pool` says how a pool is
	// built and who gets a connection next, and this module knows only that
	// there is somewhere to send a command.
	//
	// `gateway` is that pool's process, carried alongside the closure for the
	// one thing a closure cannot express: whether there is still anyone on the
	// other end of it. A `send` to a process that has ended is silently
	// dropped, so without this a caller would wait for ever for a reply nobody
	// is left to compute. Monitoring it turns that wait into an error.
	Pooled(control fn(Control) Nil, gateway Pid)
}

// What a direct `Conn` writes its bytes down.
//
// A sum rather than a flag, because the language refuses to let it be a flag:
// `socket.write` does not accept a `TlsSocket` and `tls.write` does not accept
// a `Socket` (scarlet/net/tls.scrl), so "wrote the password to the unencrypted
// half" cannot be written here at all. Every byte this client sends or receives
// goes through the four functions below, and they are the only place that has
// to know which kind it is holding.
//
// Not `pub`: `Conn` is opaque, so nothing outside this module can reach one.
// `socket_of` deliberately does not hand it out — see the note there.
type Transport {
	Plain(sock Socket)
	// Named `Secure` and not `Tls` only because `RedisError` already has a
	// `Tls` variant and the two would collide in this module's namespace.
	Secure(sock tls.TlsSocket)
}

// The four transport operations, each lifting its own error type into
// `RedisError` so that everything above this line is written once rather than
// once per transport.

fn transport_write(t Transport, data Binary) Result(Nil, RedisError) {
	match t {
		Plain(sock) -> net_err(socket.write(sock, data))
		Secure(sock) -> tls_err(tls.write(sock, data))
	}
}

// One write carrying several requests.
//
// The plain half uses `socket.write_parts`, which reaches the kernel in one
// vectored syscall without concatenating. `tls` has no `write_parts`, so the
// TLS half joins the parts first and issues a single `tls.write`. That is one
// TLS record rather than one per command — not merely a workaround for the
// missing function, since a record per command would leak the batch's shape
// into the ciphertext lengths and cost a header and a MAC each time.
fn transport_write_all(t Transport, parts Array(Binary)) Result(Nil, RedisError) {
	match t {
		Plain(sock) -> net_err(socket.write_parts(sock, parts))
		Secure(sock) -> tls_err(tls.write(sock, join(parts)))
	}
}

// `scarlet/binary` has no `concat`, so the fold is written out here.
fn join(parts Array(Binary)) Binary {
	array.fold(parts, <<>>, binary.append)
}

fn transport_read(t Transport, max Int) Result(Read, RedisError) {
	match t {
		Plain(sock) -> net_err(socket.read(sock, max))
		Secure(sock) -> tls_err(tls.read(sock, max))
	}
}

fn transport_close(t Transport) Nil {
	match t {
		Plain(sock) -> socket.close(sock) or Nil
		Secure(sock) -> tls.close(sock) or Nil
	}
}

// What a pooled `Conn` can ask of the pool behind it. Two variants because
// those are the two things a *client* wants — run this, and close up — while
// how a pool matches work to connections stays the pool's own business.
pub type Control {
	Dispatch(job Job)
	Shutdown(done Subject(Nil))
}

// A unit of work with the caller's result type erased.
//
// `lease` is generic in what your block returns, but a mailbox carries one type
// and a pool queues jobs from every caller in the program. So the job closes
// over its own reply subject and does the sending itself: the type stays inside
// the closure, where it is still checked, and what the pool queues mentions no
// caller's type at all.
//
// It takes a `Result` rather than a `Conn` because a pool whose dial failed
// still owes an answer. It passes that failure in, and the caller gets it as
// the result of their command.
pub type Job = fn(Result(Conn, RedisError)) Health

// Whether the connection a job ran on is fit to hand to the next caller. The
// pool acts on this; the judgement is made here, because it is read off the
// error variants this module defines.
pub type Health {
	Healthy
	Broken
}

// The six ways a command fails, kept apart because they call for different
// responses: `Net` means the connection is gone, `Server` means Redis
// understood the command and refused it, `Protocol` means the bytes on the
// wire were not the RESP we expected — a bug here, a desync, or a server that
// is not Redis — and `Misuse` means the call was wrong before it ever reached
// the wire, which is the price of letting one connection and a pool of them
// share a type.
//
// `Pool` is the fifth and belongs only to a pooled `Conn`: the pool that owed
// this command an answer ended before it gave one. It is not the network, not
// the server, not the wire and not the caller — it is the machinery in
// between, and it is the answer a caller gets instead of waiting for ever.
//
// `Tls` is the sixth and is kept out of `Net` rather than folded into it,
// because a `NetError` cannot spell `CertificateUnknownIssuer` or
// `HostnameMismatch` and flattening them would throw away the one distinction
// the TLS module exists to make: a caller may retry `tls.Transport`, and must
// never retry its way past a certificate that did not verify.
pub type RedisError {
	Net(err NetError)
	Server(message String)
	Protocol(why String)
	Misuse(why String)
	Pool(fault PoolFault)
	Tls(err tls.TlsError)
}

// Why a pooled command has no answer.
//
// A pool runs in a process of its own, so every one of these is that process
// being gone; they differ in what the runtime could still say about it at the
// moment the command asked. That timing matters more than it looks: the
// runtime keeps nothing about a process once it has finished, so how a pool
// died is knowable only while it is dying.
//
// Which makes `Forgotten` the common answer and the others the narrow ones. A
// pool that was stopped, crashed or killed at any point before this command
// all read the same afterwards, and a caller that wants to tell them apart
// wants the failure at `start`, or the stderr line a crash prints, rather than
// this. What this is for is the decision every caller does have to make:
// whether there is any point asking again. There is not.
pub type PoolFault {
	// It was already gone when the command asked. The ordinary reading of a
	// pool that is well and truly finished, whatever finished it.
	Forgotten
	// It ended by returning, which is what `stop` makes it do — so the command
	// was sent to a pool the program had already finished with. Seen only when
	// the two race closely enough that the runtime has not let go yet; a pool
	// stopped a moment earlier reads as `Forgotten`.
	Stopped
	// It was killed, or something linked to it was. A worker of this library
	// crashing arrives here rather than as `Crashed`, since what reaches the
	// pool's own process is the link, not the fault.
	Killed
	// The pool's own process raised a runtime error. A bug in this library
	// rather than in the program using it, and the error is carried rather
	// than described so that a report can say which one it was.
	Crashed(crash Crash)
}

// Read a monitor's notice as the fault it is. The one place that turns the
// runtime's account of a dead process into this library's, and total in both
// directions, so a pool can never fail in a way it has no name for.
pub fn pool_ended(down Down) RedisError {
	Pool(match down.reason {
		process.Normal -> Stopped
		process.Crashed(crash) -> Crashed(crash)
		process.Killed -> Killed
		process.NoProcess -> Forgotten
	})
}

// ---------------------------------------------------------------------------
// Connecting.
// ---------------------------------------------------------------------------

// Connect, run `next` with the connection, and close it on the way out —
// whether `next` succeeded, failed, or the connect never happened. Written for
// backpassing, which is what makes a script of commands read like a script:
//
//	conn <- redis.with_conn('127.0.0.1', 6379)
//	...commands...
//
// The result is flattened rather than nested: a failure to connect and a
// failure inside the body are both `RedisError`, and `Result(Result(a, e), e)`
// would make every caller unwrap the same error type twice.
pub fn with_conn(host String, port Int, next fn(Conn) Result(a, RedisError)) Result(a, RedisError) {
	match resource.try_with(fn() connect(host, port), close, next) {
		Ok(inner) -> inner
		Err(e) -> Err(e)
	}
}

// Dial, then negotiate RESP3 before handing the connection back, so a `Conn`
// in hand is always one whose replies this client can read.
//
// `HELLO 3` is not optional here. A server that refuses it — anything before
// Redis 6 — would keep answering in RESP2, where a map is a flat array and a
// double is a bulk string, and the decoders would misread those shapes
// quietly. Failing at connect is the only honest option.
pub fn connect(host String, port Int) Result(Conn, RedisError) {
	sock <- result.then(net_err(net.connect(host, port)))
	hello(Direct(transport: Plain(sock: sock)))
}

// `connect` over TLS — the `rediss://` dial.
//
// `tls.connect` completes the handshake before it returns, so a certificate
// that does not verify is reported by this call rather than surfacing later at
// an unrelated command. It is the whole handshake from the first byte, which is
// what `rediss://` is; the STARTTLS-shaped `tls.handshake` door is not involved.
//
// `host` is both the address dialled and the name the certificate is checked
// against. There is no argument here that relaxes that, because there is none
// in the language: a private CA is trusted by adding it to the trust store the
// machine already has, never by asking the client to stop checking.
pub fn connect_tls(host String, port Int) Result(Conn, RedisError) {
	sock <- result.then(tls_err(tls.connect(host, port)))
	hello(Direct(transport: Secure(sock: sock)))
}

// The RESP3 handshake both dials share, so that a `Conn` from either is equally
// one whose replies this client can read.
fn hello(c Conn) Result(Conn, RedisError) {
	match command(c, ['HELLO', '3']) {
		Ok(_) -> Ok(c)
		Err(Server(message)) -> {
			close(c)
			Err(Protocol('server refused RESP3 (needs Redis 6 or newer): ${message}'))
		}
		Err(e) -> {
			close(c)
			Err(e)
		}
	}
}

// Connect and authenticate in the same handshake, for a server that demands
// AUTH before it will accept anything else. Plain `connect` sends a bare
// `HELLO 3`, which a server like that refuses outright — there is no later
// moment to slip an `AUTH` in, so the credentials have to ride inside the
// handshake itself.
//
// Use username `'default'` for a server using `requirepass` and no ACL users.
pub fn connect_auth(
	host String,
	port Int,
	username String,
	password String,
) Result(Conn, RedisError) {
	sock <- result.then(net_err(net.connect(host, port)))
	hello_auth(Direct(transport: Plain(sock: sock)), username, password)
}

// `connect_auth` over TLS. The credentials ride inside the handshake exactly as
// they do in the clear; what changes is that they no longer cross the network
// in it.
pub fn connect_tls_auth(
	host String,
	port Int,
	username String,
	password String,
) Result(Conn, RedisError) {
	sock <- result.then(tls_err(tls.connect(host, port)))
	hello_auth(Direct(transport: Secure(sock: sock)), username, password)
}

fn hello_auth(c Conn, username String, password String) Result(Conn, RedisError) {
	match command(c, ['HELLO', '3', 'AUTH', username, password]) {
		Ok(_) -> Ok(c)
		Err(e) -> {
			close(c)
			Err(e)
		}
	}
}

// The authenticated counterpart to `with_conn`.
pub fn with_conn_auth(
	host String,
	port Int,
	username String,
	password String,
	next fn(Conn) Result(a, RedisError),
) Result(a, RedisError) {
	match resource.try_with(fn() connect_auth(host, port, username, password), close, next) {
		Ok(inner) -> inner
		Err(e) -> Err(e)
	}
}

pub fn close(c Conn) Nil {
	match c {
		Direct(t) -> transport_close(t)
		// A pooled handle is a copy, and closing a copy must not take the
		// pool's connections out from under everyone else holding one.
		// `pool.stop` is the single way to end a pool.
		Pooled(_, _) -> Nil
	}
}

// The underlying cleartext socket. Pub/Sub needs it to take the connection over
// for server-pushed messages; ordinary command code should not.
//
// A pool has no one socket to give, and could not lend one either: a
// `Subscription` owns its socket for as long as it lives, so a connection
// leased for a subscription would never come back. Hence the `Result` — a
// subscriber wants a connection of its own.
//
// A TLS connection is refused here rather than this returning the `Transport`
// sum, and the reason is not that the break would be inconvenient. `Subscription`
// needs a read with a deadline, and `tls` has no `read_within`: handing out a
// TLS transport would buy a `Subscription` that cannot implement
// `next_within` at all. So the sum stays private and this stays cleartext-only
// until the language grows a bounded TLS read, which is what pub/sub over TLS
// actually waits on. The refusal is loud — a subscriber gets this error at the
// call rather than a connection that quietly turned out to be in the clear.
pub fn socket_of(c Conn) Result(Socket, RedisError) {
	match c {
		Direct(Plain(sock)) -> Ok(sock)
		Direct(Secure(_)) ->
			Err(Misuse('pub/sub needs a cleartext connection: TLS has no bounded read yet'))
		Pooled(_, _) -> Err(Misuse('this needs a connection of its own, not a pooled one'))
	}
}

// ---------------------------------------------------------------------------
// One connection, start to finish.
// ---------------------------------------------------------------------------

// Run `next` on a single connection, whatever kind of `Conn` this is.
//
// On a socket-backed one that is just `next(c)`. On a pooled one it is the
// point of the pool: the block travels to whichever connection comes free, runs
// there, and its answer travels back. What `next` captures is copied there and
// what it returns is copied back — ordinary values, so ordinary code.
//
// This is what every command below goes through, and `pool.with_conn` is its
// public name. Reach for it directly when a run of commands must share one
// connection — WATCH/MULTI is the case that cannot do without it — since two
// separate commands on a pool may land on two different connections.
//
// The `Conn` handed to `next` must not outlive the block: on a pool it is a
// borrowed connection that goes back the moment `next` returns.
pub fn lease(c Conn, next fn(Conn) Result(a, RedisError)) Result(a, RedisError) {
	match c {
		Direct(_) -> next(c)
		Pooled(control, gateway) -> {
			reply = process.subject()
			// The reply and the pool's death arrive in the same mailbox, as the
			// same type, so exactly one of them is received and neither can be
			// waited on past the other. The monitor goes on before the job does:
			// a pool that is already gone fires it at once, which is the case
			// this exists for.
			watch = process.monitor(gateway, reply, fn(down) Err(pool_ended(down)))
			control(
				Dispatch(job: fn(leased) {
					outcome = result.then(leased, next)
					process.send(reply, outcome)
					health(outcome)
				}),
			)
			answer = process.receive(reply)
			process.demonitor(watch)
			answer
		}
	}
}

// Whether a finished job leaves its connection fit for the next caller.
//
// A `Server` error is Redis answering: it read the command, disliked it, and
// said so, and the connection is exactly where it was. A `Misuse` never reached
// the wire at all. `Net` and `Protocol` are not like that. One is a socket that
// is gone; the other is bytes that were not the reply we expected, and a stream
// that may be one reply out of step would hand the wrong answer to every
// command after it. A connection that might be desynced is worth less than the
// reconnect it costs, so the pool drops it.
pub fn health(outcome Result(a, RedisError)) Health {
	match outcome {
		Ok(_) -> Healthy
		Err(Server(_)) -> Healthy
		Err(Misuse(_)) -> Healthy
		Err(Net(_)) -> Broken
		Err(Protocol(_)) -> Broken
		// Never actually reached: a `Pool` error is made by the caller when its
		// monitor fires, not by a job, and a job is the only thing whose health
		// is judged. Answered rather than ignored, because the connection it
		// would be judging is one whose process has just ended.
		Err(Pool(_)) -> Broken
		Err(Tls(e)) -> tls_health(e)
	}
}

// Whether a connection that failed with a TLS error is worth keeping.
//
// Every variant answers `Broken`, but for two different reasons, and they are
// written out one variant at a time rather than under a `_` so that an eleventh
// `TlsError` — one that might genuinely be retryable — cannot be absorbed into
// this judgement without someone deciding it here.
//
// The certificate variants are dial-time failures: `tls.connect` finishes the
// handshake before it returns a socket, so a connection that reached a pool has
// already verified. If one is somehow seen here the connection never came up,
// and a retry reaches the same certificate — nothing about waiting changes what
// the peer presents.
//
// The rest are the record layer or the socket under it failing mid-exchange. A
// broken TLS stream is worse than a desynced plaintext one: the sequence
// numbers are gone, so it cannot be re-framed by reading ahead the way
// `read_reply` recovers a boundary, and there is nothing to do but dial again.
fn tls_health(e tls.TlsError) Health {
	match e {
		tls.CertificateUnknownIssuer -> Broken
		tls.CertificateExpired -> Broken
		tls.CertificateNotYetValid -> Broken
		tls.CertificateRevoked -> Broken
		tls.HostnameMismatch -> Broken
		tls.BadCertificate -> Broken
		tls.InvalidServerName -> Broken
		tls.ProtocolError -> Broken
		tls.HandshakeFailed -> Broken
		tls.Transport(_) -> Broken
	}
}

// Build a pooled connection out of the pool's own sending code and the process
// behind it. `pool.start` is the only sensible caller.
pub fn pooled(control fn(Control) Nil, gateway Pid) Conn {
	Pooled(control: control, gateway: gateway)
}

// Release whatever is behind this `Conn` and wait until it is released: a pool
// drains and closes every connection, a plain one closes its socket. `pool.stop`
// is the public name; it lives here because only this module can see which kind
// of `Conn` it was handed.
pub fn shutdown(c Conn) Nil {
	match c {
		Direct(_) -> close(c)
		Pooled(control, gateway) -> {
			done = process.subject()
			// A pool that crashed is also a pool that is closed, and the caller
			// asked to be told when it was closed. Both answers are `Nil`, so
			// this is `stop` returning rather than parking on a mailbox whose
			// sender has already gone.
			watch = process.monitor(gateway, done, fn(_) Nil)
			control(Shutdown(done))
			process.receive(done)
			process.demonitor(watch)
		}
	}
}

// ---------------------------------------------------------------------------
// The request/reply cycle.
// ---------------------------------------------------------------------------

// Send a command and read its reply. Every typed command in `./redis/` is a
// thin wrapper over this.
//
// An error reply comes back as `Err(Server(..))`, not as an `Ok` holding a
// `RedisErr` — a caller that forgets to match one variant of a six-variant
// type would otherwise treat "wrong number of arguments" as a successful
// result. The connection itself is fine after one: Redis answered, it just
// said no.
pub fn command(c Conn, args Array(String)) Result(Value, RedisError) {
	command_raw(c, array.map(args, binary.from_string))
}

// `command` for keys and values that are bytes rather than text. Redis keys
// and values are binary-safe, and a caller storing a JPEG should not have to
// pretend it is a String.
// On a pool this is one checkout: the command goes to a free connection and the
// reply comes back. Ten commands in a row are ten checkouts, and may land on ten
// different connections — cheap, and exactly what you want for independent work.
// When they are not independent, put them in one `pool.with_conn`.
pub fn command_raw(c Conn, args Array(Binary)) Result(Value, RedisError) {
	match c {
		Direct(t) -> exchange(t, args)
		Pooled(_, _) -> lease(c, fn(direct) command_raw(direct, args))
	}
}

fn exchange(t Transport, args Array(Binary)) Result(Value, RedisError) {
	_ <- result.then(transport_write(t, resp.encode_command(args)))
	match read_reply(t, <<>>) {
		Ok(RedisErr(message)) -> Err(server_error(message))
		// RESP3 can carry an error as a length-prefixed blob, so that it may
		// contain a newline. Same meaning, different framing.
		Ok(BlobErr(message)) -> Err(server_error(message))
		other -> other
	}
}

// ---------------------------------------------------------------------------
// Pipelining.
// ---------------------------------------------------------------------------

// Send several commands in one go and collect every reply, in order.
//
// A round trip costs a network latency whether it carries one command or a
// hundred, so a hundred commands sent one at a time cost a hundred latencies
// and pipelined cost one. That is the whole of it.
//
// The outer `Result` is the connection: a failed write, or bytes that were not
// RESP. The inner one is each command's own answer, so a single `SET` that was
// refused does not discard the ninety-nine replies around it. The `expect_*`
// decoders take exactly that inner type, so a reply is read the same way it
// would be from `command`:
//
//	replies <- result.then(redis.pipeline(c, [['GET', 'a'], ['LLEN', 'b']]))
//	match replies {
//		[a, b] -> {
//			value <- result.then(redis.expect_bulk(a))
//			count <- result.then(redis.expect_int(b))
//			...
//		}
//		_ -> Err(redis.Protocol('expected two replies'))
//	}
//
// This is not a transaction. The commands are not atomic and another client's
// work can interleave with them; `transactions.transaction` wraps a pipeline
// in MULTI/EXEC when that matters.
pub fn pipeline(
	c Conn,
	commands Array(Array(String)),
) Result(Array(Result(Value, RedisError)), RedisError) {
	pipeline_raw(c, array.map(commands, fn(args) array.map(args, binary.from_string)))
}

pub fn pipeline_raw(
	c Conn,
	commands Array(Array(Binary)),
) Result(Array(Result(Value, RedisError)), RedisError) {
	match c {
		Direct(t) -> exchange_many(t, commands)
		// The whole batch goes to one connection and comes back as one round
		// trip, exactly as it would unpooled.
		Pooled(_, _) -> lease(c, fn(direct) pipeline_raw(direct, commands))
	}
}

fn exchange_many(
	t Transport,
	commands Array(Array(Binary)),
) Result(Array(Result(Value, RedisError)), RedisError) {
	count = array.length(commands)
	if count == 0 {
		Ok([])
	} else {
		// One write for the whole batch, so the round trip a pipeline exists to
		// save is actually saved. How that write is issued differs per transport
		// and `transport_write_all` is where that difference lives.
		_ <- result.then(transport_write_all(t, array.map(commands, resp.encode_command)))
		read_replies(t, <<>>, 0, count, [])
	}
}

// Read exactly `remaining` replies out of the buffer, reading more bytes only
// when the one being parsed is incomplete. Unlike `read_reply` this cannot
// treat leftover bytes as a desync until the last reply is in, because the
// bytes after reply one are reply two.
fn read_replies(
	t Transport,
	buf Binary,
	off Int,
	remaining Int,
	acc Array(Result(Value, RedisError)),
) Result(Array(Result(Value, RedisError)), RedisError) {
	if remaining == 0 {
		trailing = binary.byte_size(buf) - off
		if trailing == 0 {
			Ok(array.reverse(acc))
		} else {
			Err(Protocol('${trailing} bytes arrived past the end of the last reply'))
		}
	} else {
		match resp.parse(buf, off) {
			Bad(why) -> Err(Protocol(why))
			// Out of band, and not one of the replies we are counting.
			Done(Push(_), next) -> read_replies(t, buf, next, remaining, acc)
			Done(RedisErr(message), next) ->
				read_replies(t, buf, next, remaining - 1, [Err(server_error(message)), ..acc])
			Done(BlobErr(message), next) ->
				read_replies(t, buf, next, remaining - 1, [Err(server_error(message)), ..acc])
			Done(value, next) -> read_replies(t, buf, next, remaining - 1, [Ok(value), ..acc])
			NeedMore -> {
				read <- result.then(transport_read(t, READ_SIZE))
				match read {
					Data(chunk) -> read_replies(t, binary.append(buf, chunk), off, remaining, acc)
					Closed -> Err(Net(UnexpectedEof))
				}
			}
		}
	}
}

// Lift a socket-level failure into the client's error type. Every `NetError`
// this client reports passes through here, so the mapping is stated once
// rather than at each call site.
pub fn net_err(r Result(a, NetError)) Result(a, RedisError) {
	result.map_err(r, Net)
}

// The same for a TLS-level failure. Kept separate from `net_err` rather than
// unwrapping `tls.Transport(cause)` into `Net(cause)`: which layer refused
// tells a caller whether to retry, and merging them loses it.
pub fn tls_err(r Result(a, tls.TlsError)) Result(a, RedisError) {
	result.map_err(r, Tls)
}

// Parse from the front of the buffer, reading more bytes whenever the reply is
// not all there yet. One `socket.read` is not one reply: a big reply arrives
// over many reads, which is exactly why the parser resumes from offset 0 on
// the grown buffer instead of trying to parse each chunk on its own.
fn read_reply(t Transport, buf Binary) Result(Value, RedisError) {
	read_from(t, buf, 0)
}

fn read_from(t Transport, buf Binary, off Int) Result(Value, RedisError) {
	match resp.parse(buf, off) {
		Bad(why) -> Err(Protocol(why))
		// A push frame is not the answer to anything — it is a pub/sub message
		// or a tracking invalidation that happened to arrive first. Step over
		// it and keep reading for the reply we are actually owed. Pushes are
		// delivered through `pubsub.Subscription`; a command connection that
		// has not subscribed will never see one.
		Done(Push(_), next) -> read_from(t, buf, next)
		Done(value, next) -> {
			trailing = binary.byte_size(buf) - next
			if trailing == 0 {
				Ok(value)
			} else {
				// Bytes we never asked for. Reading on would pair every later
				// command with the wrong reply, so stop here and say so.
				Err(Protocol('${trailing} bytes arrived past the end of the reply'))
			}
		}
		NeedMore -> {
			read <- result.then(transport_read(t, READ_SIZE))
			match read {
				Data(chunk) -> read_from(t, binary.append(buf, chunk), off)
				// The peer hung up mid-reply. Not a clean end: we were promised
				// more bytes.
				Closed -> Err(Net(UnexpectedEof))
			}
		}
	}
}

// ---------------------------------------------------------------------------
// Building arguments.
// ---------------------------------------------------------------------------

// Optional command modifiers render as argument fragments that are either
// present or absent, so the command modules below read as a list of pieces to
// splice together rather than a chain of if/else around array building.

pub fn arg(n Int) String {
	int.to_string(n)
}

// `args` when `cond` holds, nothing otherwise.
pub fn when(cond Bool, args Array(a)) Array(a) {
	if cond {
		args
	} else {
		[]
	}
}

// `f(v)` when the option is present, nothing otherwise.
pub fn when_some(o Option(a), f fn(a) Array(String)) Array(String) {
	match o {
		Some(v) -> f(v)
		None -> []
	}
}

// Splice argument fragments into one argument list. Generic over the element
// type so the same helper builds a `command_raw` argument list out of Binary
// pieces — a RESTORE payload is bytes, not text.
pub fn parts(fragments Array(Array(a))) Array(a) {
	array.fold(fragments, [], fn(acc, f) array.concat(acc, f))
}

// Flatten pairs — field/value, member/score, key/value — into the alternating
// form Redis expects.
pub fn flatten_pairs(pairs Array((String, String))) Array(String) {
	array.fold(pairs, [], fn(acc, p) match p {
		(a, b) -> array.concat(acc, [a, b])
	})
}

// ---------------------------------------------------------------------------
// Decoding replies.
// ---------------------------------------------------------------------------
//
// Each decoder takes the result of `command` and refines it, so a typed
// command is one line: `expect_int(command(c, ['LLEN', key]))`. An `Err`
// passes straight through, which is what lets them compose without every
// command re-matching the error case.

pub fn expect_ok(reply Result(Value, RedisError)) Result(Nil, RedisError) {
	status <- result.then(expect_status(reply))
	match status {
		'OK' -> Ok(Nil)
		other -> Err(Protocol('expected OK, got ${other}'))
	}
}

// Discard the reply, keeping only success or failure.
pub fn expect_any(reply Result(Value, RedisError)) Result(Nil, RedisError) {
	result.map(reply, fn(_) Nil)
}

pub fn expect_status(reply Result(Value, RedisError)) Result(String, RedisError) {
	value <- result.then(reply)
	match value {
		SimpleStr(bytes) -> text(bytes)
		Bulk(bytes) -> text(bytes)
		// CLIENT INFO and LOLWUT answer with a verbatim string under RESP3;
		// the format hint is metadata about how to display it, not content.
		Verbatim(_, bytes) -> text(bytes)
		other -> Err(Protocol('expected a status reply, got ${describe(other)}'))
	}
}

// A string that must be there. Use `expect_bulk` where the server may answer
// null.
pub fn expect_string(reply Result(Value, RedisError)) Result(String, RedisError) {
	value <- result.then(reply)
	match value {
		Null -> Err(Protocol('expected a string, got null'))
		other -> expect_status(Ok(other))
	}
}

pub fn expect_bulk(reply Result(Value, RedisError)) Result(Option(String), RedisError) {
	value <- result.then(reply)
	match value {
		Null -> Ok(None)
		SimpleStr(bytes) -> result.map(text(bytes), Some)
		Bulk(bytes) -> result.map(text(bytes), Some)
		Verbatim(_, bytes) -> result.map(text(bytes), Some)
		other -> Err(Protocol('expected a bulk string, got ${describe(other)}'))
	}
}

// The bytes of a bulk reply, undecoded — for values that are not text.
pub fn expect_binary(reply Result(Value, RedisError)) Result(Option(Binary), RedisError) {
	value <- result.then(reply)
	match value {
		Null -> Ok(None)
		Bulk(bytes) -> Ok(Some(bytes))
		SimpleStr(bytes) -> Ok(Some(bytes))
		Verbatim(_, bytes) -> Ok(Some(bytes))
		other -> Err(Protocol('expected a bulk string, got ${describe(other)}'))
	}
}

pub fn expect_int(reply Result(Value, RedisError)) Result(Int, RedisError) {
	value <- result.then(reply)
	match value {
		Num(n) -> Ok(n)
		other -> Err(Protocol('expected an integer, got ${describe(other)}'))
	}
}

// An integer that may be absent — a null reply, as several commands use for
// "no such element" (ZRANK, LPOS, OBJECT FREQ).
pub fn expect_opt_int(reply Result(Value, RedisError)) Result(Option(Int), RedisError) {
	value <- result.then(reply)
	match value {
		Null -> Ok(None)
		Num(n) -> Ok(Some(n))
		other -> Err(Protocol('expected an integer or null, got ${describe(other)}'))
	}
}

// Redis spells booleans as the integers 0 and 1.
// Redis spells most booleans as the integers 0 and 1, but RESP3 has a real
// boolean and scripts can return one, so both are accepted.
pub fn expect_bool(reply Result(Value, RedisError)) Result(Bool, RedisError) {
	value <- result.then(reply)
	match value {
		Boolean(b) -> Ok(b)
		Num(n) -> Ok(n != 0)
		other -> Err(Protocol('expected a boolean, got ${describe(other)}'))
	}
}

// True when the command applied, False when a condition (NX/XX) prevented it.
// The distinction arrives as OK versus null, not as an integer.
pub fn expect_applied(reply Result(Value, RedisError)) Result(Bool, RedisError) {
	value <- result.then(reply)
	match value {
		Null -> Ok(False)
		SimpleStr(_) -> Ok(True)
		other -> Err(Protocol('expected a status or null, got ${describe(other)}'))
	}
}

// A double, which Redis sends as a bulk string.
pub fn expect_score(reply Result(Value, RedisError)) Result(Score, RedisError) {
	value <- result.then(reply)
	value_score(value)
}

pub fn expect_opt_score(reply Result(Value, RedisError)) Result(Option(Score), RedisError) {
	value <- result.then(reply)
	match value {
		Null -> Ok(None)
		other -> result.map(value_score(other), Some)
	}
}

// An array whose every element is a string. A null element is an error here;
// `expect_opt_strings` is for the commands that can return one.
pub fn expect_strings(reply Result(Value, RedisError)) Result(Array(String), RedisError) {
	values <- result.then(expect_values(reply))
	collect(array.map(values, value_text))
}

// An array that may hold nulls, as MGET and HMGET do for missing keys and
// fields. The nulls are positional — element i answers argument i — so they
// are kept rather than filtered out.
pub fn expect_opt_strings(
	reply Result(Value, RedisError),
) Result(Array(Option(String)), RedisError) {
	values <- result.then(expect_values(reply))
	collect(
		array.map(values, fn(v) match v {
			Null -> Ok(None)
			other -> result.map(value_text(other), Some)
		}),
	)
}

// An array that is itself null — a blocking command that timed out, or a
// transaction that was aborted by WATCH. Distinct from an empty array, which
// is a real answer meaning "nothing matched".
pub fn expect_opt_strings_or_nil(
	reply Result(Value, RedisError),
) Result(Option(Array(String)), RedisError) {
	value <- result.then(reply)
	match value {
		Null -> Ok(None)
		other -> result.map(expect_strings(Ok(other)), Some)
	}
}

// A flat array read as pairs: HGETALL, CONFIG GET, and ZRANGE WITHSCORES all
// send `[a, b, a, b, ...]` under RESP2 rather than a map or nested pairs.
// Pairs, however this server chose to shape them. RESP3 answers HGETALL and
// CONFIG GET with a real map, HRANDFIELD WITHVALUES with an array of
// two-element arrays, and HSCAN with the flat alternating array RESP2 always
// used — three shapes for one idea. Absorbing that here is what keeps every
// command module identical across the two protocols.
pub fn expect_pairs(reply Result(Value, RedisError)) Result(Array((String, String)), RedisError) {
	entries <- result.then(expect_entries(reply))
	collect(
		array.map(entries, fn(e) match e {
			(k, v) -> {
				name <- result.then(value_text(k))
				body <- result.then(value_text(v))
				Ok((name, body))
			}
		}),
	)
}

// The shape-tolerant core the pair decoders share.
pub fn expect_entries(reply Result(Value, RedisError)) Result(Array((Value, Value)), RedisError) {
	value <- result.then(reply)
	match value {
		Map(entries) -> Ok(entries)
		List(items) -> entries_of(items)
		Set(items) -> entries_of(items)
		other -> Err(Protocol('expected pairs, got ${describe(other)}'))
	}
}

// An array of pairs is either nested — `[[k, v], [k, v]]` — or flat, and the
// first element is enough to tell which.
fn entries_of(items Array(Value)) Result(Array((Value, Value)), RedisError) {
	match items {
		[] -> Ok([])
		[first, .._] -> match first {
			List([_, _]) -> collect(array.map(items, as_entry))
			Set([_, _]) -> collect(array.map(items, as_entry))
			_ -> flat_entries(items, [])
		}
	}
}

fn as_entry(v Value) Result((Value, Value), RedisError) {
	match v {
		List([k, x]) -> Ok((k, x))
		Set([k, x]) -> Ok((k, x))
		other -> Err(Protocol('expected a pair, got ${describe(other)}'))
	}
}

fn flat_entries(
	items Array(Value),
	acc Array((Value, Value)),
) Result(Array((Value, Value)), RedisError) {
	match items {
		[] -> Ok(acc)
		[k, v, ..rest] -> flat_entries(rest, array.concat(acc, [(k, v)]))
		_ -> Err(Protocol('expected an even number of elements'))
	}
}

// A flat map whose values are not all strings. HELLO is the case that forces
// this: most of its fields are text, but `modules` is an array, and decoding
// the lot as strings fails on that one field. The keys are always text, so
// only the values stay raw.
pub fn expect_fields(reply Result(Value, RedisError)) Result(Array((String, Value)), RedisError) {
	entries <- result.then(expect_entries(reply))
	collect(
		array.map(entries, fn(e) match e {
			(k, v) -> result.map(value_text(k), fn(name) (name, v))
		}),
	)
}

// The same shape, where the second of each pair is a score.
// Member/score pairs. RESP3 nests them and sends the score as a double, RESP2
// flattened them and sent it as a bulk string, and ZSCAN uses the flat form
// under both — all three land here.
pub fn expect_scored(reply Result(Value, RedisError)) Result(Array((String, Score)), RedisError) {
	entries <- result.then(expect_entries(reply))
	collect(
		array.map(entries, fn(e) match e {
			(m, s) -> {
				member <- result.then(value_text(m))
				score <- result.then(value_score(s))
				Ok((member, score))
			}
		}),
	)
}

// How long something has left to live. The two sentinels Redis uses — -1 for
// "exists but never expires" and -2 for "no such key or field" — become
// constructors, so a caller cannot mistake them for durations and do
// arithmetic on them. Shared by the key TTLs and the hash field TTLs, which
// use the same encoding.
pub type Remaining {
	Expires(in_ Int)
	NoExpiry
	Missing
}

pub fn to_remaining(n Int) Remaining {
	if n == 0 - 1 {
		NoExpiry
	} else if n == 0 - 2 {
		Missing
	} else {
		Expires(n)
	}
}

pub fn expect_remaining(reply Result(Value, RedisError)) Result(Remaining, RedisError) {
	result.map(expect_int(reply), to_remaining)
}

// A SCAN-family reply: the cursor to resume from, and this batch of elements.
// A cursor of 0 means the iteration is complete.
pub fn expect_scan(reply Result(Value, RedisError)) Result((Int, Array(String)), RedisError) {
	values <- result.then(expect_values(reply))
	match values {
		[cursor, elements] -> {
			text <- result.then(value_text(cursor))
			items <- result.then(expect_strings(Ok(elements)))
			match number.parse_int(text) {
				Ok(n) -> Ok((n, items))
				Err(Nil) -> Err(Protocol('scan cursor is not an integer: ${text}'))
			}
		}
		_ -> Err(Protocol('expected a scan reply of cursor and elements'))
	}
}

// The raw elements, for replies whose shape is nested or heterogeneous —
// XRANGE, GEOPOS, EXEC. The command module that knows the shape decodes it.
pub fn expect_values(reply Result(Value, RedisError)) Result(Array(Value), RedisError) {
	value <- result.then(reply)
	match value {
		List(items) -> Ok(items)
		// A RESP3 set is an array whose order the server does not promise —
		// which it never did for SMEMBERS anyway.
		Set(items) -> Ok(items)
		other -> Err(Protocol('expected an array, got ${describe(other)}'))
	}
}

pub fn expect_opt_values(reply Result(Value, RedisError)) Result(Option(Array(Value)), RedisError) {
	value <- result.then(reply)
	match value {
		Null -> Ok(None)
		other -> result.map(expect_values(Ok(other)), Some)
	}
}

// ---------------------------------------------------------------------------
// Decoding helpers, shared with the command modules.
// ---------------------------------------------------------------------------

// The text of a single element, for modules decoding a nested reply by hand.
pub fn value_text(v Value) Result(String, RedisError) {
	match v {
		Bulk(bytes) -> text(bytes)
		SimpleStr(bytes) -> text(bytes)
		Verbatim(_, bytes) -> text(bytes)
		Num(n) -> Ok(int.to_string(n))
		BigNum(digits) -> text(digits)
		other -> Err(Protocol('expected a string element, got ${describe(other)}'))
	}
}

pub fn value_int(v Value) Result(Int, RedisError) {
	match v {
		Num(n) -> Ok(n)
		Bulk(bytes) -> match number.parse_int_binary(bytes) {
			Ok(n) -> Ok(n)
			Err(Nil) -> Err(Protocol('expected an integer element'))
		}
		other -> Err(Protocol('expected an integer element, got ${describe(other)}'))
	}
}

// A score arrives as a real double under RESP3 and as a bulk string under
// RESP2 — and INCRBYFLOAT still answers with a bulk string under both.
pub fn value_score(v Value) Result(Score, RedisError) {
	match v {
		Dbl(value) -> Ok(value)
		other -> {
			s <- result.then(value_text(other))
			to_score(s)
		}
	}
}

pub fn to_score(s String) Result(Score, RedisError) {
	match number.parse_score(s) {
		Ok(v) -> Ok(v)
		Err(Nil) -> Err(Protocol('not a number: ${s}'))
	}
}

// Read an array of replies — EXEC's, for instance — as per-command results, so
// an error inside it is an `Err` a caller cannot walk past rather than a
// `Value` variant they might forget to match.
pub fn as_replies(values Array(Value)) Array(Result(Value, RedisError)) {
	array.map(values, fn(v) match v {
		RedisErr(message) -> Err(server_error(message))
		BlobErr(message) -> Err(server_error(message))
		other -> Ok(other)
	})
}

// Turn an array of results into a result of an array, failing on the first
// error. The shape every element-wise decoder above needs.
pub fn collect(results Array(Result(a, RedisError))) Result(Array(a), RedisError) {
	array.fold(results, Ok([]), fn(acc, r) {
		items <- result.then(acc)
		v <- result.then(r)
		Ok(array.concat(items, [v]))
	})
}

fn text(bytes Binary) Result(String, RedisError) {
	match binary.to_string(bytes) {
		Ok(s) -> Ok(s)
		Err(Nil) -> Err(Protocol('reply is not valid UTF-8'))
	}
}

fn server_error(message Binary) RedisError {
	Server(binary.to_string(message) or '<not utf-8>')
}

// `command` has already turned an error reply into `Err(Server(..))`, so
// `RedisErr` never reaches the decoders — but `Value` still has the variant,
// and naming it here keeps the matches exhaustive.
fn describe(v Value) String {
	match v {
		SimpleStr(_) -> 'a status'
		RedisErr(_) -> 'an error'
		BlobErr(_) -> 'an error'
		Num(_) -> 'an integer'
		Bulk(_) -> 'a bulk string'
		Verbatim(_, _) -> 'a verbatim string'
		Null -> 'null'
		List(_) -> 'an array'
		Set(_) -> 'a set'
		Map(_) -> 'a map'
		Push(_) -> 'a push message'
		Dbl(_) -> 'a double'
		Boolean(_) -> 'a boolean'
		BigNum(_) -> 'a big number'
	}
}

pub fn show_error(e RedisError) String {
	match e {
		Net(err) -> 'network error: ${string.inspect(err)}'
		Server(message) -> 'server said: ${message}'
		Protocol(why) -> 'protocol error: ${why}'
		Misuse(why) -> 'misused: ${why}'
		Pool(fault) -> 'pool error: ${show_pool_fault(fault)}'
		// Inspected rather than described arm by arm, as `Net` is: the variant
		// name is the useful part and `TlsError` names its own failures well.
		Tls(err) -> 'tls error: ${string.inspect(err)}'
	}
}

pub fn show_pool_fault(f PoolFault) String {
	match f {
		Stopped -> 'the pool had already been stopped'
		Crashed(crash) -> 'the pool crashed: ${string.inspect(crash)}'
		Killed -> 'the pool was killed'
		Forgotten -> 'the pool was already gone'
	}
}

pub fn zrevrange(c Conn, key String, start Int, stop Int) Result(Array(String), RedisError) {
	redis.expect_strings(redis.command(c, ['ZREVRANGE', key, redis.arg(start), redis.arg(stop)]))
}

pub fn zrevrange_withscores(
	c Conn,
	key String,
	start Int,
	stop Int,
) Result(Array((String, Score)), RedisError) {
	redis.expect_scored(
		redis.command(c, ['ZREVRANGE', key, redis.arg(start), redis.arg(stop), 'WITHSCORES']),
	)
}

// The TLS rig: a Scarlet program against a real TLS-terminating Redis.
//
//	./scripts/tls-certs.sh                       # once
//	docker compose --profile tls up -d
//	SSL_CERT_FILE=test/tls/ca.crt scarlet run test/tls.scrl   # trusted arms
//	scarlet run test/tls.scrl                                 # untrusted arm
//
// **The negative arms are the point of this file.** A TLS client that accepts
// any certificate still returns PONG, so a rig that only checks for PONG
// cannot tell an encrypted connection from a credulous one. Three separate
// ways of being the wrong peer are checked, and each must come back as its own
// `TlsError` rather than merely as "an error".
//
// Trust is granted through `SSL_CERT_FILE`, which is what `rustls-native-certs`
// reads on Unix. That ADDS a root; it does not disable checking — the
// wrong-name arm below fails *while it is set*, which is what proves it. There
// is deliberately no way to ask the runtime to skip verification, and nothing
// here switches it off. Nothing is written to the machine's trust store, so
// there is nothing to undo after a run.
//
// WHICH ARMS RUN DEPENDS ON `SSL_CERT_FILE`, because the untrusted-issuer arm
// needs it absent and the other three need it present, and one process cannot
// have it both ways. The mode is printed: a run that reports one check is not a
// run that passed four.
//
// THIS PROGRAM CANNOT FAIL A GATE. Like every other program in this repo it
// prints its verdict and exits 0 — Scarlet has no exit, panic or assert yet
// (T-271). CI does not run it, and wiring it up before T-271 would buy a green
// that asserts nothing.

import scarlet/array
import scarlet/binary
import scarlet/int
import scarlet/net
import scarlet/net/socket.{Closed, Data}
import scarlet/net/tls
import scarlet/os
import scarlet/string
import ../number
import ../redis
import ../resp

const DEFAULT_HOST = 'localhost'

const DEFAULT_PORT = 6380

// ---------------------------------------------------------------------------
// Assertions.
// ---------------------------------------------------------------------------

type Check {
	name String
	ok Bool
	detail String
}

fn is(name String, got String, want String) Check {
	Check(name, got == want, 'expected ${want}, got ${got}')
}

fn report(checks Array(Check)) Int {
	array.fold(checks, 0, fn(failures, c) match c {
		Check(name, True, _) -> {
			println('  ok    ${name}')
			failures
		}
		Check(name, False, detail) -> {
			println('  FAIL  ${name}: ${detail}')
			failures + 1
		}
	})
}

// ---------------------------------------------------------------------------
// Naming the failure, not just noticing one.
// ---------------------------------------------------------------------------

fn show_error(e tls.TlsError) String {
	match e {
		tls.CertificateUnknownIssuer -> 'CertificateUnknownIssuer'
		tls.CertificateExpired -> 'CertificateExpired'
		tls.CertificateNotYetValid -> 'CertificateNotYetValid'
		tls.CertificateRevoked -> 'CertificateRevoked'
		tls.HostnameMismatch -> 'HostnameMismatch'
		tls.BadCertificate -> 'BadCertificate'
		tls.ProtocolError -> 'ProtocolError'
		tls.HandshakeFailed -> 'HandshakeFailed'
		tls.InvalidServerName -> 'InvalidServerName'
		tls.Transport(_) -> 'Transport'
	}
}

// ---------------------------------------------------------------------------
// The arms.
// ---------------------------------------------------------------------------

// PING over TLS, encoded by this repo's own RESP encoder. Until `Conn` can be
// TLS-backed (T-246) that encoder is the most of the client a TLS rig can
// exercise, and it is the half that proves bytes survive the record layer.
fn ping(host String, port Int) String {
	match tls.connect(host, port) {
		Err(e) -> show_error(e)
		Ok(c) -> {
			reply = ping_on(c)
			_ = tls.close(c)
			reply
		}
	}
}

fn ping_on(c tls.TlsSocket) String {
	match tls.write(c, resp.encode_command([<<'PING'>>])) {
		Err(e) -> 'write: ${show_error(e)}'
		Ok(Nil) -> match tls.read(c, 64) {
			Err(e) -> 'read: ${show_error(e)}'
			Ok(Closed) -> 'closed before a reply'
			Ok(Data(bytes)) -> match binary.to_string(bytes) {
				Ok(s) -> string.trim(s)
				Err(Nil) -> 'reply was not UTF-8'
			}
		}
	}
}

// The name a certificate is checked against, when it is not the name we dialled.
//
// `tls.connect` resolves the name before it verifies it, so a malformed name
// errs `Transport` at DNS resolution and never reaches verification. The split
// `net.connect` + `tls.handshake` form is the only route that reaches
// `InvalidServerName`.
fn handshake_as(host String, port Int, name String) String {
	match net.connect(host, port) {
		Err(_) -> 'could not connect'
		Ok(sock) -> match tls.handshake(sock, name) {
			Err(e) -> show_error(e)
			Ok(c) -> {
				_ = tls.close(c)
				'HANDSHAKE_OK'
			}
		}
	}
}

// ---------------------------------------------------------------------------
// The client itself, over TLS.
// ---------------------------------------------------------------------------

// Everything above dials `scarlet/net/tls` by hand, because until T-246 the
// client had no TLS transport to dial. These arms exercise the client: a
// `Conn` that is TLS-backed, reached through `redis.connect_tls`.

// A `Conn` in hand is one that has already negotiated RESP3, on TLS exactly as
// on plaintext — `connect_tls` runs `HELLO 3` inside the dial. If it did not,
// the server would still be answering in RESP2 and the decoders below would
// misread a map as a flat array.
fn client_ping(host String, port Int) String {
	match redis.connect_tls(host, port) {
		Err(e) -> redis.show_error(e)
		Ok(c) -> {
			reply = match redis.expect_status(redis.command(c, ['PING'])) {
				Err(e) -> redis.show_error(e)
				Ok(s) -> s
			}
			redis.close(c)
			reply
		}
	}
}

// A pipeline over TLS must produce the same replies, in the same order, as the
// same batch would in the clear. This is the arm that covers the one place the
// two transports genuinely differ: `socket.write_parts` sends the batch as one
// vectored write, and `tls` has no `write_parts`, so the TLS half concatenates
// and issues a single `tls.write`.
//
// Three commands whose replies are all different shapes and which are ordered
// by construction — `INCR` after `SET` is 2, and `GET` after that is '2'. A
// batch that lost a command, or reordered one, or paired a reply with the wrong
// request cannot produce this string.
fn client_pipeline(host String, port Int) String {
	match redis.connect_tls(host, port) {
		Err(e) -> redis.show_error(e)
		Ok(c) -> {
			reply = pipeline_on(c)
			redis.close(c)
			reply
		}
	}
}

fn pipeline_on(c redis.Conn) String {
	key = 'tls:rig:pipeline'
	batch = [['SET', key, '1'], ['INCR', key], ['GET', key]]
	match redis.pipeline(c, batch) {
		Err(e) -> redis.show_error(e)
		Ok(replies) -> match replies {
			[a, b, d] -> {
				set = show_reply(a, redis.expect_status)
				incr = show_reply(b, fn(v) match redis.expect_int(v) {
					Ok(n) -> Ok(int.to_string(n))
					Err(e) -> Err(e)
				})
				got = show_reply(d, redis.expect_string)
				'${set},${incr},${got}'
			}

			_ -> 'expected three replies, got ${int.to_string(array.length(replies))}'
		}
	}
}

// The `expect_*` decoders take the whole `Result`, not the `Value` inside it,
// so that one reply of a pipeline is read exactly as `command`'s would be.
fn show_reply(
	r Result(resp.Value, redis.RedisError),
	decode fn(Result(resp.Value, redis.RedisError)) Result(String, redis.RedisError),
) String {
	match decode(r) {
		Ok(s) -> s
		Err(e) -> redis.show_error(e)
	}
}

// ---------------------------------------------------------------------------
// The two arm sets.
// ---------------------------------------------------------------------------

// With the test CA trusted. The wrong-name arm is here rather than in the
// untrusted set on purpose: an untrusted issuer would mask it, and what needs
// witnessing is that a name is still checked once the issuer is accepted.
fn trusted_arms(host String, port Int) Array(Check) {
	[
		is('PING over TLS', ping(host, port), '+PONG'),
		// server.crt carries SAN DNS:localhost and no IP SAN, so the address
		// verifies against nothing. It is NOT refused as an unusable name:
		// rustls accepts an IP literal as a server name and checks it against
		// the certificate's IP SANs, of which this certificate has none.
		is(
			'wrong name is refused',
			handshake_as('127.0.0.1', port, '127.0.0.1'),
			'HostnameMismatch',
		),
		is('malformed name is refused', handshake_as(host, port, 'bad_name!'), 'InvalidServerName'),
		is('client PING over TLS', client_ping(host, port), 'PONG'),
		is('client pipeline over TLS', client_pipeline(host, port), 'OK,2,2'),
	]
}

// With no trust granted at all.
fn untrusted_arms(host String, port Int) Array(Check) {
	[is('untrusted issuer is refused', ping(host, port), 'CertificateUnknownIssuer')]
}

fn run(host String, port Int) Nil {
	(mode, checks) = match os.get_env('SSL_CERT_FILE') {
		Some(path) -> ('trusted via SSL_CERT_FILE=${path}', trusted_arms(host, port))
		None -> ('no SSL_CERT_FILE set', untrusted_arms(host, port))
	}
	println('TLS rig against ${host}:${int.to_string(port)}, ${mode}')
	println('')
	failures = report(checks)
	total = array.length(checks)
	println('')
	if failures == 0 {
		println('${int.to_string(total)} checks, all passed')
	} else {
		println('${int.to_string(total)} checks, ${int.to_string(failures)} FAILED')
	}
}

pub fn main() Nil {
	match os.argv() {
		[_, host, port] -> match number.parse_int(port) {
			Ok(p) -> run(host, p)
			Err(Nil) -> println('port must be a number')
		}
		[_, host] -> run(host, DEFAULT_PORT)
		_ -> run(DEFAULT_HOST, DEFAULT_PORT)
	}
}
